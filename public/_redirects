# Markdown twins: serve the .txt copies (with frontmatter) for .md URLs.
# SpaceFast serves extensionless files inconsistently, so .md -> .txt rewrites
# give agents a reliable markdown representation.
/index.md      /index.txt      200
/about.md      /about.txt      200
/contact.md    /contact.txt    200
/privacy.md    /privacy.txt    200
/developers.md /developers.txt 200
/auth.md       /auth.txt       200
/pricing.md    /pricing.txt    200
/llms.md       /llms.txt       200
# Unknown paths return a real 404 (all app routes are prerendered static files).
/*  /404.html  404
